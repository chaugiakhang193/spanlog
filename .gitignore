# Environment files hold local secrets. Only the example file is tracked.
.env
.env.*
!.env.example

# Node dependencies and build output
node_modules/
dist/
coverage/

# Go test binaries and coverage profiles
*.test
*.out

# Logs
*.log
npm-debug.log*

# Python environments, caches and build output
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
